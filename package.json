{
  "name": "@toddpress/glint",
  "version": "0.1.0",
  "description": "A tiny, signal-powered framework for building Web Components that doesn’t hate you back.",
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "start": "vite",
    "build:codepen": "rollup -c --configCodepen",
    "watch:codepen": "rollup -c --configCodepen --watch",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "build": "rollup -c",
    "test:browser": "node test/browser-smoke.js",
    "build:examples": "vite build",
    "preview:examples": "vite preview"
  },
  "exports": {
    ".": "./src/index.js",
    "./signals": "./src/signals.js",
    "./diagnostics": "./src/diagnostics/index.js"
  },
  "files": [
    "src",
    "dist/glint.js",
    "dist/glint.codepen.js"
  ],
  "dependencies": {
    "@preact/signals-core": "^1.12.1"
  },
  "sideEffects": false,
  "keywords": [
    "web-components",
    "signals",
    "reactive",
    "framework",
    "glint"
  ],
  "author": "Todd Pressley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toddpress/glint"
  },
  "bugs": {
    "url": "https://github.com/toddpress/glint/issues"
  },
  "homepage": "https://glintjs.vercel.app/",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "jsdom": "26.1.0",
    "playwright-core": "1.58.2",
    "rollup": "^4.53.3",
    "tunajs": "^1.1.3",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
